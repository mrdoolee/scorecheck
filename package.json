{
  "name": "scorecheck",
  "productName": "ScoreCheck",
  "version": "0.8.0",
  "private": true,
  "description": "몇점 (ScoreCheck) — 성적 확인·서명 데스크톱 앱 (로컬 전용)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "author": "ScoreCheck",
  "build": {
    "appId": "kr.scorecheck.desktop",
    "productName": "ScoreCheck",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{web,image_decoders,types}/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/hotspot.ps1",
        "to": "hotspot.ps1"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      }
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "shortcutName": "몇점",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "몇점 (ScoreCheck)",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "executableName": "ScoreCheck",
    "artifactName": "ScoreCheck-Setup-${version}.${ext}"
  }
}
